# À fournir uniquement dans les paramètres sécurisés de Vercel ou .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Choisissez un secret aléatoire d’au moins 32 caractères, retirez-le après installation.
# FABI_SETUP_TOKEN=

# Production Vercel uniquement : secret de la tâche quotidienne (calendriers, Wi-Fi mensuel et rappels d’arrivée)
CRON_SECRET=

# Gmail notifications (server only; use a Google app password, never your usual password)
GMAIL_USER=
# Pause des e-mails équipe : seul le compte fondateur reçoit les notifications.
# Passer à true uniquement sur nouvelle demande explicite pour reprendre les nouveaux envois.
FABI_TEAM_EMAILS_ENABLED=false
GMAIL_APP_PASSWORD=

# Accès technique Hermes : authentification obligatoire avec sa clé privée dédiée.
# L’accès autonome et la durée sans expiration se choisissent dans Accès Hermes.
# false permet de bloquer aussi les sessions techniques ; aucune clé n’est créée automatiquement.
FABI_INTEGRATION_ENABLED=true
# Arrêt d’urgence des ajouts Hermes. Sans cette variable, seules les permissions
# « Ajouter des réservations / dépenses » explicitement accordées permettent les ajouts.
# FABI_INTEGRATION_WRITES_ENABLED=false
