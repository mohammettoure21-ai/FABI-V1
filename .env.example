# À fournir uniquement dans les paramètres sécurisés de Vercel ou .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
# Choisissez un secret aléatoire d’au moins 32 caractères, retirez-le après installation.
# FABI_SETUP_TOKEN=

# Production Vercel uniquement : secret de la tâche quotidienne (calendriers, Wi-Fi mensuel et rappels d’arrivée)
CRON_SECRET=

# Gmail notifications (server only; use a Google app password, never your usual password)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Accès technique Hermes : authentification obligatoire et confirmation pour le dashboard.
# false permet de bloquer aussi les sessions techniques ; aucune clé n’est créée automatiquement.
FABI_INTEGRATION_ENABLED=true
